  <diagram name="Page-1" id="mAIEbnJeWJNUhrlVula5">
    <mxGraphModel dx="1632" dy="1361" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    %% =====================\n    %% CLASES BASE / CATÁLOGOS\n    %% =====================\n\n    class Role {\n        -Long id\n        -String name\n        -String description\n        -LocalDateTime createdAt\n        -LocalDateTime updatedAt\n        +Role()\n        +Role(String name, String description)\n        +getId() Long\n        +setId(Long id) void\n        +getName() String\n        +setName(String name) void\n        +getDescription() String\n        +setDescription(String description) void\n        +getCreatedAt() LocalDateTime\n        +setCreatedAt(LocalDateTime createdAt) void\n        +getUpdatedAt() LocalDateTime\n        +setUpdatedAt(LocalDateTime updatedAt) void\n        +toString() String\n        +equals(Object o) boolean\n        +hashCode() int\n    }\n\n    class User {\n        -Long id\n        -Role role\n        -String firstName\n        -String lastName\n        -String email\n        -String passwordHash\n        -LocalDateTime createdAt\n        -LocalDateTime updatedAt\n        +User()\n        +User(Role role, String firstName, String lastName, String email, String passwordHash)\n        +getId() Long\n        +setId(Long id) void\n        +getRole() Role\n        +setRole(Role role) void\n        +getFirstName() String\n        +setFirstName(String firstName) void\n        +getLastName() String\n        +setLastName(String lastName) void\n        +getEmail() String\n        +setEmail(String email) void\n        +getPasswordHash() String\n        +setPasswordHash(String passwordHash) void\n        +getFullName() String\n        +verifyPassword(String rawPassword, PasswordEncoder encoder) boolean\n        +getCreatedAt() LocalDateTime\n        +getUpdatedAt() LocalDateTime\n        +toString() String\n        +equals(Object o) boolean\n        +hashCode() int\n    }\n\n    class Category {\n        -Long id\n        -String name\n        -String description\n        -LocalDateTime createdAt\n        -LocalDateTime updatedAt\n        +Category()\n        +Category(String name, String description)\n        +getId() Long\n        +setId(Long id) void\n        +getName() String\n        +setName(String name) void\n        +getDescription() String\n        +setDescription(String description) void\n        +getCreatedAt() LocalDateTime\n        +getUpdatedAt() LocalDateTime\n        +toString() String\n        +equals(Object o) boolean\n        +hashCode() int\n    }\n\n    class Brand {\n        -Long id\n        -String name\n        -String description\n        -LocalDateTime createdAt\n        -LocalDateTime updatedAt\n        +Brand()\n        +Brand(String name, String description)\n        +getId() Long\n        +setId(Long id) void\n        +getName() String\n        +setName(String name) void\n        +getDescription() String\n        +setDescription(String description) void\n        +getCreatedAt() LocalDateTime\n        +getUpdatedAt() LocalDateTime\n        +toString() String\n        +equals(Object o) boolean\n        +hashCode() int\n    }\n\n    class ProductStatus {\n        -Long id\n        -String code\n        -String name\n        -String description\n        -LocalDateTime createdAt\n        -LocalDateTime updatedAt\n        +ProductStatus()\n        +ProductStatus(String code, String name, String description)\n        +getId() Long\n        +setId(Long id) void\n        +getCode() String\n        +setCode(String code) void\n        +getName() String\n        +setName(String name) void\n        +getDescription() String\n        +setDescription(String description) void\n        +getCreatedAt() LocalDateTime\n        +getUpdatedAt() LocalDateTime\n        +toString() String\n        +equals(Object o) boolean\n        +hashCode() int\n    }\n\n    class Store {\n        -Long id\n        -String name\n        -String logoUrl\n        -String websiteUrl\n        -LocalDateTime createdAt\n        -LocalDateTime updatedAt\n        +Store()\n        +Store(String name, String logoUrl, String websiteUrl)\n        +getId() Long\n        +setId(Long id) void\n        +getName() String\n        +setName(String name) void\n        +getLogoUrl() String\n        +setLogoUrl(String logoUrl) void\n        +getWebsiteUrl() String\n        +setWebsiteUrl(String websiteUrl) void\n        +getCreatedAt() LocalDateTime\n        +getUpdatedAt() LocalDateTime\n        +toString() String\n        +equals(Object o) boolean\n        +hashCode() int\n    }\n\n    class UsagePurpose {\n        -Long id\n        -String name\n        -String description\n        -LocalDateTime createdAt\n        -LocalDateTime updatedAt\n        +UsagePurpose()\n        +UsagePurpose(String name, String description)\n        +getId() Long\n        +setId(Long id) void\n        +getName() String\n        +setName(String name) void\n        +getDescription() String\n        +setDescription(String description) void\n        +getCreatedAt() LocalDateTime\n        +getUpdatedAt() LocalDateTime\n        +toString() String\n        +equals(Object o) boolean\n        +hashCode() int\n    }\n\n    %% =====================\n    %% PRODUCTO Y ESPECIFICACIONES\n    %% =====================\n\n    class Product {\n        -Long id\n        -Category category\n        -Brand brand\n        -ProductStatus status\n        -String name\n        -String model\n        -String description\n        -String imageUrl\n        -BigDecimal referencePrice\n        -List~ProductSpecification~ specifications\n        -List~ProductStoreLink~ storeLinks\n        -LocalDateTime createdAt\n        -LocalDateTime updatedAt\n        +Product()\n        +Product(Category category, Brand brand, ProductStatus status, String name, String model)\n        +getId() Long\n        +setId(Long id) void\n        +getCategory() Category\n        +setCategory(Category category) void\n        +getBrand() Brand\n        +setBrand(Brand brand) void\n        +getStatus() ProductStatus\n        +setStatus(ProductStatus status) void\n        +getName() String\n        +setName(String name) void\n        +getModel() String\n        +setModel(String model) void\n        +getDescription() String\n        +setDescription(String description) void\n        +getImageUrl() String\n        +setImageUrl(String imageUrl) void\n        +getReferencePrice() BigDecimal\n        +setReferencePrice(BigDecimal referencePrice) void\n        +getSpecifications() List~ProductSpecification~\n        +addSpecification(ProductSpecification spec) void\n        +removeSpecification(ProductSpecification spec) void\n        +getStoreLinks() List~ProductStoreLink~\n        +addStoreLink(ProductStoreLink link) void\n        +removeStoreLink(ProductStoreLink link) void\n        +isAvailable() boolean\n        +getCreatedAt() LocalDateTime\n        +getUpdatedAt() LocalDateTime\n        +toString() String\n        +equals(Object o) boolean\n        +hashCode() int\n    }\n\n    class ProductSpecification {\n        -Long id\n        -Product product\n        -String specificationName\n        -String valueText\n        -BigDecimal valueNumber\n        -String unit\n        -LocalDateTime createdAt\n        -LocalDateTime updatedAt\n        +ProductSpecification()\n        +ProductSpecification(Product product, String specificationName, String valueText, BigDecimal valueNumber, String unit)\n        +getId() Long\n        +setId(Long id) void\n        +getProduct() Product\n        +setProduct(Product product) void\n        +getSpecificationName() String\n        +setSpecificationName(String specificationName) void\n        +getValueText() String\n        +setValueText(String valueText) void\n        +getValueNumber() BigDecimal\n        +setValueNumber(BigDecimal valueNumber) void\n        +getUnit() String\n        +setUnit(String unit) void\n        +getCreatedAt() LocalDateTime\n        +getUpdatedAt() LocalDateTime\n        +toString() String\n        +equals(Object o) boolean\n        +hashCode() int\n    }\n\n    class ProductStoreLink {\n        -Long id\n        -Product product\n        -Store store\n        -String url\n        -LocalDateTime createdAt\n        -LocalDateTime updatedAt\n        +ProductStoreLink()\n        +ProductStoreLink(Product product, Store store, String url)\n        +getId() Long\n        +setId(Long id) void\n        +getProduct() Product\n        +setProduct(Product product) void\n        +getStore() Store\n        +setStore(Store store) void\n        +getUrl() String\n        +setUrl(String url) void\n        +getCreatedAt() LocalDateTime\n        +getUpdatedAt() LocalDateTime\n        +toString() String\n        +equals(Object o) boolean\n        +hashCode() int\n    }\n\n    %% =====================\n    %% CONFIGURACIONES\n    %% =====================\n\n    class ConfigurationRequest {\n        -Long id\n        -User user\n        -UsagePurpose usagePurpose\n        -BigDecimal budget\n        -List~Configuration~ configurations\n        -LocalDateTime createdAt\n        -LocalDateTime updatedAt\n        +ConfigurationRequest()\n        +ConfigurationRequest(User user, UsagePurpose usagePurpose, BigDecimal budget)\n        +getId() Long\n        +setId(Long id) void\n        +getUser() User\n        +setUser(User user) void\n        +getUsagePurpose() UsagePurpose\n        +setUsagePurpose(UsagePurpose usagePurpose) void\n        +getBudget() BigDecimal\n        +setBudget(BigDecimal budget) void\n        +getConfigurations() List~Configuration~\n        +addConfiguration(Configuration configuration) void\n        +removeConfiguration(Configuration configuration) void\n        +isBudgetValid() boolean\n        +getCreatedAt() LocalDateTime\n        +getUpdatedAt() LocalDateTime\n        +toString() String\n        +equals(Object o) boolean\n        +hashCode() int\n    }\n\n    class Configuration {\n        -Long id\n        -ConfigurationRequest request\n        -Character optionLabel\n        -BigDecimal totalReferencePrice\n        -BigDecimal score\n        -String explanation\n        -List~ConfigurationItem~ items\n        -LocalDateTime createdAt\n        -LocalDateTime updatedAt\n        +Configuration()\n        +Configuration(ConfigurationRequest request, Character optionLabel)\n        +getId() Long\n        +setId(Long id) void\n        +getRequest() ConfigurationRequest\n        +setRequest(ConfigurationRequest request) void\n        +getOptionLabel() Character\n        +setOptionLabel(Character optionLabel) void\n        +getTotalReferencePrice() BigDecimal\n        +setTotalReferencePrice(BigDecimal totalReferencePrice) void\n        +getScore() BigDecimal\n        +setScore(BigDecimal score) void\n        +getExplanation() String\n        +setExplanation(String explanation) void\n        +getItems() List~ConfigurationItem~\n        +addItem(ConfigurationItem item) void\n        +removeItem(ConfigurationItem item) void\n        +calculateTotal() BigDecimal\n        +isWithinBudget(BigDecimal budget) boolean\n        +getCreatedAt() LocalDateTime\n        +getUpdatedAt() LocalDateTime\n        +toString() String\n        +equals(Object o) boolean\n        +hashCode() int\n    }\n\n    class ConfigurationItem {\n        -Long id\n        -Configuration configuration\n        -Product product\n        -Integer quantity\n        -BigDecimal unitReferencePrice\n        -LocalDateTime createdAt\n        -LocalDateTime updatedAt\n        +ConfigurationItem()\n        +ConfigurationItem(Configuration configuration, Product product, Integer quantity, BigDecimal unitReferencePrice)\n        +getId() Long\n        +setId(Long id) void\n        +getConfiguration() Configuration\n        +setConfiguration(Configuration configuration) void\n        +getProduct() Product\n        +setProduct(Product product) void\n        +getQuantity() Integer\n        +setQuantity(Integer quantity) void\n        +getUnitReferencePrice() BigDecimal\n        +setUnitReferencePrice(BigDecimal unitReferencePrice) void\n        +calculateSubtotal() BigDecimal\n        +getCreatedAt() LocalDateTime\n        +getUpdatedAt() LocalDateTime\n        +toString() String\n        +equals(Object o) boolean\n        +hashCode() int\n    }\n\n    %% =====================\n    %% RELACIONES\n    %% =====================\n\n    Role \&quot;1\&quot; --&gt; \&quot;0..*\&quot; User : asigna\n    Category \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Product : clasifica\n    Brand \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Product : produce\n    ProductStatus \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Product : estado\n    Product \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ProductSpecification : define\n    Product \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ProductStoreLink : enlaza\n    Store \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ProductStoreLink : publica\n    User \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ConfigurationRequest : solicita\n    UsagePurpose \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ConfigurationRequest : motiva\n    ConfigurationRequest \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Configuration : genera A/B\n    Configuration \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ConfigurationItem : compone\n    Product \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ConfigurationItem : participa&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="MU-rhi5zZNxFdhcrxP5A-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
