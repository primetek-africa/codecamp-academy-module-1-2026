        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {&#39;theme&#39;:&#39;base&#39;,&#39;themeVariables&#39;:{&#39;background&#39;:&#39;#FFFFFF&#39;,&#39;primaryColor&#39;:&#39;#FFFFFF&#39;,&#39;primaryTextColor&#39;:&#39;#1F2937&#39;,&#39;primaryBorderColor&#39;:&#39;#374151&#39;,&#39;lineColor&#39;:&#39;#6B7280&#39;,&#39;secondaryColor&#39;:&#39;#F9FAFB&#39;,&#39;tertiaryColor&#39;:&#39;#FFFFFF&#39;,&#39;fontFamily&#39;:&#39;Helvetica, Arial, sans-serif&#39;,&#39;fontSize&#39;:&#39;13px&#39;,&#39;edgeLabelBackground&#39;:&#39;#FFFFFF&#39;}}}%%\nerDiagram\n    roles                  ||--o{ users                  : \&quot;asigna\&quot;\n    categories             ||--o{ products               : \&quot;clasifica\&quot;\n    brands                 ||--o{ products               : \&quot;produce\&quot;\n    product_statuses       ||--o{ products               : \&quot;estado\&quot;\n    products               ||--o{ product_specifications : \&quot;define\&quot;\n    products               ||--o{ product_store_links    : \&quot;enlaza\&quot;\n    stores                 ||--o{ product_store_links    : \&quot;publica\&quot;\n    users                  ||--o{ configuration_requests : \&quot;solicita\&quot;\n    usage_purposes         ||--o{ configuration_requests : \&quot;motiva\&quot;\n    configuration_requests ||--o{ configurations         : \&quot;genera A/B\&quot;\n    configurations         ||--o{ configuration_items    : \&quot;compone\&quot;\n    products               ||--o{ configuration_items    : \&quot;participa\&quot;\n\n    roles {\n        BIGINT id PK\n        VARCHAR(30) name UK\n        VARCHAR(255) description\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }\n\n    users {\n        BIGINT id PK\n        BIGINT role_id FK\n        VARCHAR(100) first_name\n        VARCHAR(100) last_name\n        VARCHAR(255) email UK\n        VARCHAR(255) password_hash\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }\n\n    categories {\n        BIGINT id PK\n        VARCHAR(100) name UK\n        TEXT description\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }\n\n    brands {\n        BIGINT id PK\n        VARCHAR(100) name UK\n        TEXT description\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }\n\n    product_statuses {\n        BIGINT id PK\n        VARCHAR(20) code UK\n        VARCHAR(60) name\n        VARCHAR(255) description\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }\n\n    products {\n        BIGINT id PK\n        BIGINT category_id FK\n        BIGINT brand_id FK\n        BIGINT status_id FK\n        VARCHAR(200) name\n        VARCHAR(150) model\n        TEXT description\n        TEXT image_url\n        NUMERIC(12,2) reference_price\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }\n\n    product_specifications {\n        BIGINT id PK\n        BIGINT product_id FK\n        VARCHAR(100) specification_name\n        TEXT value_text\n        NUMERIC(14,3) value_number\n        VARCHAR(30) unit\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }\n\n    stores {\n        BIGINT id PK\n        VARCHAR(150) name UK\n        TEXT logo_url\n        TEXT website_url\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }\n\n    product_store_links {\n        BIGINT id PK\n        BIGINT product_id FK\n        BIGINT store_id FK\n        TEXT url\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }\n\n    usage_purposes {\n        BIGINT id PK\n        VARCHAR(100) name UK\n        VARCHAR(255) description\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }\n\n    configuration_requests {\n        BIGINT id PK\n        BIGINT user_id FK\n        BIGINT usage_purpose_id FK\n        NUMERIC(12,2) budget\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }\n\n    configurations {\n        BIGINT id PK\n        BIGINT request_id FK\n        CHAR(1) option_label\n        NUMERIC(12,2) total_reference_price\n        NUMERIC(10,3) score\n        TEXT explanation\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }\n\n    configuration_items {\n        BIGINT id PK\n        BIGINT configuration_id FK\n        BIGINT product_id FK\n        INTEGER quantity\n        NUMERIC(12,2) unit_reference_price\n        TIMESTAMPTZ created_at\n        TIMESTAMPTZ updated_at\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="AXOWh9mapk9mHM-3MIK--1">
