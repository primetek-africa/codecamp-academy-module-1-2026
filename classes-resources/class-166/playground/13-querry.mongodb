/*
-------------------------------------------------------------------
Query 13 - Find all orders created between:
    -2026-08-21
    -2026-08-24
-------------------------------------------------------------------
*/

use("prime_delivery");
db.orders.find(
  {
    createdAt: {
      $gte: new Date("2026-08-21T00:00:00Z"),
      $lt: new Date("2026-08-25T00:00:00Z")
    }
  },
  {
    _id: 0,
    orderNumber: 1,
    customerEmail: 1,
    createdAt: 1,
    status: 1
  }
)