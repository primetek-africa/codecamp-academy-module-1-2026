// ===================================================================
// MongoDB Atlas Intermediate Query Activity — sample_analytics
// ===================================================================

// Connect to the database
use("sample_analytics");

// -------------------------------------------------------------------
// Query 01 - Find All Customers
// Retrieve all documents from the customers collection.
// ------------------------------------------------------------------
db.customers.find({});

// -------------------------------------------------------------------
// Query 02 — Customers From a Specific Country
// Retrieve all customers whose country is "Brazil".
// ------------------------------------------------------------------
db.customers.find({ country: "Brazil" });

// -------------------------------------------------------------------
// Query 03 — Customers With Multiple Accounts
// Find customers who have more than one account.
// $expr lets us compare the size of the accounts array using an
// aggregation-style expression inside a normal find().
// -------------------------------------------------------------------
db.customers.find({
    $expr: { $gt: [{ $size: "$accounts" }, 1] },
});

db.customers.find({
    $expr: { $gt: [{ $size: "$accounts" }, 1] },
}).count();

// -------------------------------------------------------------------
// Query 04 — Customers With a Specific Account
// Find customers whose accounts array contains the account number 371138.
// -------------------------------------------------------------------
db.customers.find({ accounts: 371138 });

// -------------------------------------------------------------------
// Query 05 — Customers From Multiple Countries
// Retrieve customers whose country is either "Brazil" or "Canada".
// -------------------------------------------------------------------
db.customers.find({ country: { $in: ["Brazil", "Canada"] } });

// -------------------------------------------------------------------
// Query 06 — Customers Excluding a Country
// Retrieve all customers whose country is not "Brazil".
// -------------------------------------------------------------------
db.customers.find({ country: { $ne: "Brazil" } });

// -------------------------------------------------------------------
// Query 07 — Accounts With High Limits
// Find all accounts whose limit is greater than 9000.
// -------------------------------------------------------------------
db.accounts.find({ limit: { $gt: 9000 } });
db.accounts.find({ limit: { $gt: 9000 } }).count();

// -------------------------------------------------------------------
// Query 08 — Accounts Within a Range
// Find accounts whose limit is between 5000 and 10000, inclusive.
// -------------------------------------------------------------------
db.accounts.find({ limit: { $gte: 5000, $lte: 10000 } });
db.accounts.find({ limit: { $gte: 5000, $lte: 10000 } }).count();

// -------------------------------------------------------------------
// Query 09 — Accounts With Specific Products
// Find accounts whose products array contains "InvestmentStock".
// -------------------------------------------------------------------
db.accounts.find({ products: "InvestmentStock" });
db.accounts.find({ products: "InvestmentStock" }).count();

// -------------------------------------------------------------------
// Query 10 — Accounts With Multiple Products
// Find accounts that contain BOTH "InvestmentStock" and "Commodity".
// $all requires every listed value to be present in the array.
// -------------------------------------------------------------------
db.accounts.find({ products: { $all: ["InvestmentStock", "Commodity"] } });
db.accounts.find({ products: { $all: ["InvestmentStock", "Commodity"] } }).count();

// -------------------------------------------------------------------
// Query 11 — Sort Accounts by Limit
// Retrieve all accounts sorted by limit, highest to lowest.
// -------------------------------------------------------------------
db.accounts.find({}).sort({ limit: -1 });

// -------------------------------------------------------------------
// Query 12 — Top Five Accounts
// Retrieve the five accounts with the highest limit.
// -------------------------------------------------------------------
db.accounts.find({}).sort({ limit: -1 }).limit(5);

// -------------------------------------------------------------------
// Query 13 — Project Customer Information
// Return only name, username, email, country. Exclude _id.
// -------------------------------------------------------------------
db.customers.find(
    {},
    {
        _id: 0,
        name: 1,
        username: 1,
        email: 1,
        country: 1,
    }
);

// -------------------------------------------------------------------
// Query 14 — Search by Email Domain
// Find customers whose email contains "@gmail.com".
// The "." is escaped with "\\." so it's treated as a literal dot
// rather than the regex "any character" wildcard.
// -------------------------------------------------------------------
db.customers.find({ email: { $regex: "@gmail\\.com", $options: "i" } });

// -------------------------------------------------------------------
// Query 15 — Accounts With Specific Products (using $in)
// Find accounts that contain EITHER "InvestmentStock" OR "Brokerage".
// -------------------------------------------------------------------
db.accounts.find({ products: { $in: ["InvestmentStock", "Brokerage"] } });

// -------------------------------------------------------------------
// Query 16 — Customers With Multiple Conditions
// From "Brazil" AND with at least one account number greater than 100000.
// $elemMatch checks that a single array element satisfies the condition.
// -------------------------------------------------------------------
db.customers.find({
    $and: [
        { country: "Brazil" },
        { accounts: { $elemMatch: { $gt: 100000 } } },
    ],
});

// -------------------------------------------------------------------
// Query 17 — Update a Customer
// Find one customer by username and update their email with $set.
// Replace "someusername" / the new email with real values before running.
// -------------------------------------------------------------------
db.customers.updateOne(
    { username: "matthewray" },
    { $set: { email: "matthewray1232@mail.com" } }
);

// -------------------------------------------------------------------
// Query 18 — Add a Product to an Account
// Find an account by account_id and push "NewProduct" into its
// products array. Replace the account number with a real one.
// -------------------------------------------------------------------
db.accounts.updateOne(
    { account_id: 371138 },
    { $push: { products: "NewProduct" } }
);

// -------------------------------------------------------------------
// Query 19 — Delete an Account
// Find an account with a specific account_id and delete that document.
// Replace with a real account number before running — this is destructive.
// -------------------------------------------------------------------
db.accounts.deleteOne({ account_id: 999999 });

// -------------------------------------------------------------------
// Query 20 — Combined Analysis Query
// limit > 5000 AND products contains "InvestmentStock",
// projected to account_id / limit / products, sorted by limit desc,
// top 5 results only.
// -------------------------------------------------------------------
db.accounts.find(
    { limit: { $gt: 5000 }, products: "InvestmentStock" },
    { _id: 0, account_id: 1, limit: 1, products: 1 }
)
.sort({ limit: -1 })
.limit(5);